{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "rootDir": "src", "outDir": "lib", "declaration": true, "skipLibCheck": true
  },
  "include": ["src/protocol.ts"]
}
